# Copy to .env and fill in. Never commit .env.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
CIVICEYE_SECRET_KEY=

# Optional overrides (defaults shown)
# CIVICEYE_DATABASE_URL=sqlite:///instance/civiceye.db
# CIVICEYE_UPLOAD_DIR=instance/uploads
# CIVICEYE_SECURE_COOKIES=0          # set to 1 when served over HTTPS
# CIVICEYE_MAX_IMAGE_MB=20
# CIVICEYE_MAX_REQUEST_MB=90
# CIVICEYE_STORE_MAX_SIDE=2560     # stored evidence is downscaled to this long side
# CIVICEYE_MAX_EXTRA_IMAGES=3
# CIVICEYE_DUPLICATE_RADIUS_M=30
# CIVICEYE_DUPLICATE_WINDOW_DAYS=30
# CIVICEYE_PRIORITY_AGE_CAP_DAYS=30
# CIVICEYE_PRIORITY_CORROBORATION_CAP=4
# CIVICEYE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# CIVICEYE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# CIVICEYE_IMAGE_WEIGHTS=            # empty = image AI unavailable (phase 1 has no trained weights)
